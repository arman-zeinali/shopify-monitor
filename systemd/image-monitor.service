[Unit]
Description=Image Monitor - Hermes and Louis Vuitton
After=network.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
User=ubuntu
WorkingDirectory=/home/ubuntu/shopify-monitor
ExecStart=/home/ubuntu/shopify-monitor/.venv/bin/python image_monitor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
